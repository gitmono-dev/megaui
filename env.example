# Public origin the app is served from (used for absolute links/redirects).
APP_BASE_URL=http://localhost:3000

# Authentication mode shared by every process. Allowed values: legacy,
# enterprise, maintenance. An absent value keeps the legacy behaviour of
# older deployments.
AUTH_MODE=legacy

# Authentication provider (FSL-116, resolveAuthMode in @megaui/core). Not read
# by any process yet: Web and collab start reading it from FSL-126/FSL-150/
# FSL-128, and the Feishu login is enabled by FSL-150/FSL-131.
# AUTH_MODE=enterprise with AUTH_PROVIDER=feishu selects the Feishu email-code
# login; AUTH_MODE=legacy accepts an absent value or local. During the
# transition (until FSL-131) AUTH_MODE=enterprise without AUTH_PROVIDER keeps the
# existing enterprise implementation and AUTH_MODE=maintenance (without a
# provider) keeps its behaviour; both are deprecated and refused from the FSL-132
# release on. An invalid AUTH_PROVIDER or a disallowed combination is refused
# with INVALID_AUTH_PROVIDER (the provider is checked first); an unknown
# AUTH_MODE with a valid provider is refused with INVALID_AUTH_MODE.
# AUTH_PROVIDER=feishu

# Feishu email-code login keys (FSL-121, readFeishuLoginConfig in
# apps/web/lib/feishu-login-config.ts). The Feishu login path does not read them
# yet (other existing paths below still use some of them): Web reads them for
# the Feishu login from FSL-150 on, with AUTH_MODE=enterprise and
# AUTH_PROVIDER=feishu.
# Required: FEISHU_APP_ID and FEISHU_APP_SECRET (set further below; non-empty,
# no whitespace or control characters) and ENTERPRISE_OTP_HMAC_KEY, the
# canonical unpadded base64url encoding of exactly 32 random bytes (43
# characters). A missing or invalid key is refused with
# INVALID_FEISHU_LOGIN_CONFIG, which names the keys and never the values.
# Optional (parsed from FSL-148 on): FEISHU_PROVIDER (default feishu; simulator
# only in development/test) and FEISHU_SIMULATOR_ORIGIN (a loopback origin).
# ENTERPRISE_OTP_HMAC_KEY=replace-with-random-32-byte-base64url-key

# Web scope is opt-in. Leave ALL five scope keys absent for independent legacy
# use. To configure scoped Web, uncomment all four fields below and provide an
# existing matching policy; Web never bootstraps ENTERPRISE_APPROVED_TARGETS.
# ENTERPRISE_PROCESS_ROLE=web
# ENTERPRISE_OWNER_FINGERPRINT=replace-with-owner-fingerprint
# ENTERPRISE_DB_INSTANCE_ID=replace-with-instance-id
# ENTERPRISE_DEPLOYMENT_ROLE=test
# Allowed deployment roles: development, test, canary, production.
# Enterprise pairing alone requires a dedicated canonical base64url 32-byte key
# and an explicit proxy JSON array (empty is allowed). These do not enable scope.
ENTERPRISE_IP_HMAC_MASTER_KEY=replace-with-random-32-byte-base64url-key
ENTERPRISE_TRUSTED_PROXY_CIDRS=[]
# Independent bearer key for the exact Web → collab eligibility introspection route.
ENTERPRISE_INTROSPECTION_KEY=replace-with-enterprise-introspection-key
# Standard Next Web uses DATABASE_URL sslmode for TLS. File certificate URL
# parameters and PGBINARY/PGSSLMODE/PGSSLNEGOTIATION/PGCLIENT_ENCODING/PGREPLICATION
# environment overrides are unsupported; fixed UTF8/non-replication settings apply.
# In enterprise mode BETTER_AUTH_URL must be an origin, with HTTPS except literal
# 127.0.0.1 or [::1] in development/test. Do not derive it from request headers.

# Feishu callback identity. Both values must match the v2 callback header.
FEISHU_TENANT_KEY=replace-with-feishu-tenant-key
FEISHU_APP_ID=replace-with-feishu-app-id

# Provision capability only: choose a fixed provider and the current run's exact
# loopback origin. Simulator requires deployment role and NODE_ENV development/test.
# These keys are not required by legacy, Web/collab, emit or operation replay.
FEISHU_PROVIDER=simulator
FEISHU_SIMULATOR_ORIGIN=http://127.0.0.1:3001
FEISHU_APP_SECRET=replace-with-feishu-app-secret
FEISHU_DIRECTORY_DEPARTMENT_IDS='["od_mock_engineering","od_mock_operations"]'


# Feishu callback verification and encryption secrets. The event route reads
# them lazily at request time; inject real values through the deployment secret
# store and never commit them.
FEISHU_EVENT_VERIFICATION_TOKEN=replace-with-feishu-event-verification-token
FEISHU_EVENT_ENCRYPT_KEY=replace-with-feishu-event-encrypt-key

# better-auth canonical base URL (usually same origin as APP_BASE_URL).
BETTER_AUTH_URL=http://localhost:3000

# better-auth session/cookie signing secret (32+ random bytes in real envs).
BETTER_AUTH_SECRET=replace-with-a-random-32-byte-secret

# Comma-separated list of origins better-auth will accept for CORS/redirects.
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:3000

# Google OAuth client id for the "Sign in with Google" provider.
GOOGLE_CLIENT_ID=replace-with-google-oauth-client-id

# Google OAuth client secret paired with GOOGLE_CLIENT_ID.
GOOGLE_CLIENT_SECRET=replace-with-google-oauth-client-secret

# GitHub OAuth client id for the "Sign in with GitHub" provider.
GITHUB_CLIENT_ID=replace-with-github-oauth-client-id

# GitHub OAuth client secret paired with GITHUB_CLIENT_ID.
GITHUB_CLIENT_SECRET=replace-with-github-oauth-client-secret

# Postgres connection string for the self-owned schema (mega2-provided
# instance; database name stays "website" per the compose naming contract).
DATABASE_URL=postgres://megaui:megaui@localhost:5432/website

# Auth-mail provider selector for Better Auth. Required. Allowed values:
# test, smtp, resend. Missing, blank, or unknown values fail closed; there is
# no default to test.
EMAIL_PROVIDER=smtp

# Required From address for Better Auth transactional email. Missing or blank
# values fail closed; there is no noreply@example.com fallback.
EMAIL_DEFAULT_FROM=noreply@example.com

# SMTP hostname. Required when EMAIL_PROVIDER=smtp. Ignored for test/resend.
SMTP_HOST=localhost

# SMTP port. Required when EMAIL_PROVIDER=smtp; must be a decimal integer
# in 1..65535. Ignored for test/resend.
SMTP_PORT=1025

# SMTP auth username. Required as a pair with SMTP_PASS when
# EMAIL_PROVIDER=smtp; both may be empty to omit auth. Ignored otherwise.
SMTP_USER=replace-with-smtp-user

# SMTP auth password. Required as a pair with SMTP_USER when
# EMAIL_PROVIDER=smtp; both may be empty to omit auth. Ignored otherwise.
SMTP_PASS=replace-with-smtp-password

# Resend API key. Required when EMAIL_PROVIDER=resend. Ignored for test/smtp.
RESEND_API_KEY=replace-with-resend-api-key

# Base URL of the mega2 HTTP API this app talks to (DIR-03 upstream).
MEGA2_PUBLIC_BASE_URL=http://localhost:8080

# Bearer token authorizing this app to call mega2's internal mail API.
MEGA2_INTERNAL_MAIL_BEARER=replace-with-internal-mail-bearer

# S3-compatible object storage endpoint (mega2-provided instance).
S3_ENDPOINT=http://localhost:9000

# S3-compatible object storage region.
S3_REGION=us-east-1

# S3-compatible object storage access key id.
S3_ACCESS_KEY_ID=replace-with-s3-access-key-id

# S3-compatible object storage access key secret.
S3_ACCESS_KEY_SECRET=replace-with-s3-access-key-secret

# S3-compatible object storage bucket name (ADR-ARCH-05). The bucket must already exist in the target store.
S3_BUCKET=megaui

# Public base URL for reading back objects stored in S3_BUCKET.
S3_PUBLIC_URL=http://localhost:19000/megaui

# Whether the S3 client must use path-style addressing (true for most
# self-hosted S3-compatible endpoints, e.g. MinIO).
S3_FORCE_PATH_STYLE=true

# Internal base URL of the mega-collab (Hocuspocus) service.
MEGA_COLLAB_INTERNAL_URL=http://localhost:7002

# Shared token authenticating this app's calls to mega-collab internally.
MEGA_COLLAB_INTERNAL_TOKEN=replace-with-collab-internal-token
# Independent collab user-revocation credential; never reuse the ticket/internal token.
ENTERPRISE_COLLAB_REVOKE_KEY=replace-with-independent-collab-revoke-key

# Public base URL browsers use to open a WebSocket to mega-collab.
NEXT_PUBLIC_MEGA_COLLAB_PUBLIC_URL=ws://localhost:7002

# Collab-server process (apps/collab-server; optional overrides):
# MEGA_COLLAB_PORT=7002
# MEGA_COLLAB_BIND=127.0.0.1
# MEGA_COLLAB_MAX_DOCUMENTS=512
# MEGA_COLLAB_MAX_CONNECTIONS=1024
# MEGA_COLLAB_DEV_ALLOW_AUTHENTICATED=1  # local/e2e only — never in production; docs rooms only (ADR-RT-02)

# Base URL of the AI provider's OpenAI-compatible API.
AI_BASE_URL=https://api.openai.com/v1

# API key for the AI provider configured via AI_BASE_URL.
AI_API_KEY=replace-with-ai-api-key

# Model identifier passed to the AI provider for chat/completions calls.
AI_MODEL=gpt-4o-mini
