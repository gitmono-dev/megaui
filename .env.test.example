# Sample for the user-provided, gitignored `.env.test` (DEP-03).
#
# Copy this file to `.env.test` and fill in real values locally to run the
# LLM-gated test cases. `.env.test` itself is never committed (see
# .gitignore / .libraignore); this file only holds placeholders.

# Base URL of the OpenAI-compatible LLM provider used for gated tests.
AI_BASE_URL=https://api.example.com/v1

# Authentication mode for the isolated test environment. Allowed values:
# legacy, enterprise (the latter only with AUTH_PROVIDER=feishu). An absent
# value means legacy.
AUTH_MODE=legacy

# Feishu app ID of the Feishu login. The tests inject a synthetic fixture value
# for each run; this sample only holds a placeholder.
FEISHU_APP_ID=replace-with-feishu-app-id

# Feishu app secret paired with FEISHU_APP_ID (placeholder only).
FEISHU_APP_SECRET=replace-with-feishu-app-secret

# Feishu provider of the tests: simulator uses the local Feishu mock in
# apps/feishu-mock and is accepted only with NODE_ENV development or test.
FEISHU_PROVIDER=simulator

# Exact loopback origin of the Feishu mock, read only with
# FEISHU_PROVIDER=simulator. Each test run starts its own mock.
FEISHU_SIMULATOR_ORIGIN=http://127.0.0.1:3001

# API key for the LLM provider configured via AI_BASE_URL (placeholder only).
AI_API_KEY=REPLACE_WITH_LOCAL_TEST_API_KEY

# Model identifier passed to the LLM provider for gated test calls.
AI_MODEL=REPLACE_WITH_TEST_MODEL_NAME
