{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": ["NEXT_PUBLIC_MEGA_COLLAB_PUBLIC_URL"],
  "tasks": {
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "build": {
      "dependsOn": ["^build"]
    },
    "lint": {
      "dependsOn": ["//#lint:deps"]
    },
    "//#lint:deps": {
      "cache": false
    }
  }
}
