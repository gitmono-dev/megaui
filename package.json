{
  "name": "megaui",
  "version": "0.1.0",
  "private": true,
  "license": "MIT OR Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "typecheck": "turbo run typecheck",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "lint:deps": "depcruise --config .dependency-cruiser.cjs apps packages",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "pnpm": {
    "overrides": {
      "esbuild@0.18.20": "0.25.12",
      "undici": "7.30.1",
      "minimatch": "11.0.1",
      "sharp": "0.35.5",
      "dompurify": "3.4.17"
    },
    "onlyBuiltDependencies": [
      "@tailwindcss/oxide",
      "esbuild",
      "sharp",
      "unrs-resolver"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.4.1",
    "dependency-cruiser": "^18.2.0",
    "eslint": "^10.9.1",
    "prettier": "^3.9.6",
    "tsx": "^4.21.0",
    "turbo": "^2.10.12",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.69.0",
    "vitest": "^4.1.11"
  }
}
